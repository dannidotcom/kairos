# Kairos environment configuration example
# Local domain: http://kairos.com:8088
DATABASE_URL=postgresql+asyncpg://kairos:kairos@kairos-postgres:5432/kairos
REDIS_URL=redis://kairos-redis:6379/0
POSTGRES_USER=kairos
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=kairos
POSTGRES_PORT=5433
REDIS_PORT=6380
ENVIRONMENT=development
LOG_LEVEL=INFO
JWT_SECRET=replace-with-a-long-random-secret
API_KEY_PEPPER=replace-with-a-long-random-pepper
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
CORS_ORIGINS=http://localhost:8088,http://localhost:5173,http://localhost:8088,http://localhost:5173,http://kairos.com:8088,http://www.kairos.com:8088
FRONTEND_URL=http://kairos.com:8088
PUBLIC_MCP_URL=http://localhost:8001/mcp
MCP_ALLOWED_HOSTS=localhost,localhost:*,127.0.0.1,127.0.0.1:*,kairos-mcp,kairos-mcp:*,host.docker.internal,host.docker.internal:*,kairos.com,kairos.com:*
MCP_ALLOWED_ORIGINS=http://localhost:8088,http://localhost:5173,http://kairos.com:8088,http://www.kairos.com:8088
DEMO_MODE=true
SEED_DEMO=true
DEMO_USER_EMAIL=demo@kairos.app
DEMO_USER_PASSWORD=change-this-demo-password
LLM_PROVIDER=heuristic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
OPENAI_BASE_URL=http://host.docker.internal:11434/v1
OPENAI_API_KEY=not-needed
OPENAI_MODEL=qwen2.5:14b
UNIPILE_DSN=
UNIPILE_API_KEY=
UNIPILE_TIMEOUT_SECONDS=20
UNIPILE_MAX_RETRIES=5
LINKEDIN_CONNECTOR_URL=
LINKEDIN_CONNECTOR_TOKEN=
LINKEDIN_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret
SEND_WINDOW_START=8
SEND_WINDOW_END=19
SCHEDULER_RUN_ACTIONS_INTERVAL_SECONDS=60
API_PORT=8000
MCP_PORT=8001
FRONTEND_PORT=8088
